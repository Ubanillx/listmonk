# Copy this file to .env and keep the copy out of version control.
# The personal API key is shown once at Profile -> API Keys after creation or rotation.
LISTMONK_BASE_URL=https://listmonk.example.com
LISTMONK_BEARER_TOKEN=lmpk_replace_with_personal_api_key

# Only set this for an administrator-managed legacy service token.
# Personal API keys are already bound to one personal or organization workspace.
# LISTMONK_ORGANIZATION_ID=42
