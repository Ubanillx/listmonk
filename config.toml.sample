[app]
# Interface and port where the app will run its webserver.  The default value
# of localhost will only listen to connections from the current machine. To
# listen on all interfaces use '0.0.0.0'. To listen on the default web address
# port, use port 80 (this will require running with elevated permissions).
address = "localhost:9000"

# Time zone of the deployment (IANA name, eg: "Asia/Shanghai", "Europe/Berlin").
# Leave it empty to follow the process time zone (the TZ environment variable,
# or the host's /etc/localtime when running the binary directly). The whole
# server uses one zone: database sessions, quota day boundaries, logs, exports
# and the admin UI. When nothing is configured, Asia/Shanghai is used.
timezone = ""

# Database.
[db]
host = "localhost"
port = 5432
user = "listmonk"
password = "listmonk"

# Ensure that this database has been created in Postgres.
database = "listmonk"

ssl_mode = "disable"
max_open = 25
max_idle = 25
max_lifetime = "300s"

# Optional space separated Postgres DSN params. eg: "application_name=listmonk gssencmode=disable"
params = ""

[privacy]
# Optional path to a local GeoLite2-City.mmdb or GeoIP2-City.mmdb file.
# New campaign opens are located approximately when tracking is enabled.
geoip_database = ""
